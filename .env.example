# Copy to .env.local and fill in AFTER you have run the SQL in database/sql (see database/README.md).
# Everything starting with VITE_ is bundled into browser code and is PUBLIC. Only put public values here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# NEVER add sb_secret_..., service_role keys, database passwords or payment secrets to this file or any VITE_ variable.
# Privileged keys belong only in server-side secrets (Lovable Cloud secrets), read inside server functions.
